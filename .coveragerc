[run]
source = src/arkiv
omit = src/arkiv/__pycache__/*
# Tests run the CLI as a subprocess (python -m arkiv.cli); measure those too.
# Each process writes its own .coverage.* file, which pytest-cov combines.
patch = subprocess
parallel = true

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__
    if TYPE_CHECKING
show_missing = true
